# Python (кэш компиляции кода)
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environment (папка виртуального окружения)
venv/
env/
.venv/

# IDE (настройки редакторов кода PyCharm и VS Code)
.idea/
.vscode/

# Secrets (секретные ключи и токены бота)
.env

# Logs (журналы ошибок)
*.log

# OS (системный мусор Windows и macOS)
.DS_Store
Thumbs.db

# Databases (файлы локальной базы данных)
*.db
*.sqlite
*.sqlite3
bookings.db

# Project specific (картинки объектов и тесты)
# Картинки квартир отдаются с Tilda CDN, локально не нужны.
# Единственная локальная картинка — static/ETVmc.jpg — исключена из игнора.
*.jpg
*.png
!static/ETVmc.jpg

# Данные приложения
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
